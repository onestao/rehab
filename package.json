{
  "name": "training-assistant",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "node scripts/build-css.mjs",
    "perf:edge": "node scripts/edge-perf-smoke.mjs",
    "icons": "node scripts/collect-icons.mjs",
    "bump": "node scripts/bump-version.js",
    "version": "node scripts/bump-version.js && git add index.html sw.js scripts/ build/",
    "lhci": "lhci autorun",
    "lint:js": "eslint -c .eslintrc.cjs --quiet .",
    "lint:css": "stylelint \"css-src/**/*.css\" --allow-empty-input",
    "lint": "npm run lint:js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --test test/*.test.mjs",
    "test:unit": "node --test --test-force-exit test/*.test.mjs",
    "test:browser:lazyload": "node --test --test-force-exit test/plan-feature-gate.browser.test.mjs test/deep-link-nav.browser.test.mjs test/ensure-deps-side-effects.browser.test.mjs test/modal-a11y.browser.test.mjs test/today-ai-picker-readiness.browser.test.mjs",
    "test:browser:web-search": "node --test --test-force-exit test/web-search-capabilities.browser.test.mjs",
    "test:evidence:lazyload": "node scripts/verify-lazyload-repair-evidence.mjs",
    "test:deps": "node --test --test-force-exit test/deps-closure.test.mjs test/entry-loaded-seed.test.mjs test/method-owner-registry.test.mjs test/data-ready-barrier.test.mjs test/offline-essential-closure.test.mjs",
    "test:browser:lifecycle": "node --test --test-force-exit test/route-lifecycle-leak.browser.test.mjs",
    "test:release": "node --test --test-force-exit test/*.test.mjs && npm run test:browser:lazyload && npm run test:browser:lifecycle && npm run test:evidence:lazyload",
    "check:css-markers": "node scripts/check-css-section-markers.mjs",
    "check:css-sources": "node scripts/check-css-source-registry.mjs",
    "check:css-overlap": "node scripts/css-overlap-report.mjs",
    "check:99-targets": "node scripts/check-99-targets.mjs",
    "check:html-safety": "node scripts/check-html-safety.mjs",
    "check:size-limit-coverage": "node scripts/check-size-limit-coverage.mjs",
    "check:css": "npm run check:css-markers && npm run check:css-sources && npm run check:99-targets && npm run check:css-overlap",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run check:css && npm run check:html-safety && npm run check:size-limit-coverage && npx --yes size-limit"
  },
  "devDependencies": {
    "@size-limit/file": "^11.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.0.0",
    "size-limit": "^11.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@tanstack/virtual-core": "^3.17.1",
    "flexsearch": "^0.8.212"
  }
}
